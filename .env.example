# Token from @BotFather. Required to run the bot (polling + scheduler).
TELEGRAM_BOT_TOKEN=

# Primary professional Arabic summarizer (Gemini). If unset, extractive+translate is used.
GEMINI_API_KEY=

# Optional: higher-quality Arabic summaries. The bot works without this.
# OPENAI_API_KEY=

# Preferred: separate Gemini keys (story rewrite vs tashkeel/split)
# GEMINI_STORY_API_KEY=
# GEMINI_TASHKEEL_API_KEY=
# Legacy single key still works as fallback:
# GEMINI_API_KEY=

# Final review / title polish (Cohere)
# COHERE_API_KEY=
